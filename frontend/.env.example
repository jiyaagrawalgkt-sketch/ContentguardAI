# =================================================================
# ContentGuard AI — Frontend Environment Configuration (.env.example)
# =================================================================
# Copy this file to .env.local in the frontend directory:
#   Copy-Item .env.example .env.local
#
# IMPORTANT: Never commit actual API keys or secrets to Git.
# =================================================================

# Backend API Base URL
# For local development with FastAPI running on port 8000:
NEXT_PUBLIC_API_URL="http://127.0.0.1:8000/api/v1"

# For production deployment (e.g. Render / Railway):
# NEXT_PUBLIC_API_URL="https://your-backend-service.onrender.com/api/v1"
