# =================================================================
# ContentGuard AI — Git & ZIP Exclusion Rules (.gitignore)
# =================================================================

# Python Virtual Environments
venv/
.venv/
env/
ENV/
backend/venv/
backend/.venv/

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
backend/.pytest_cache/
.coverage
htmlcov/

# Node.js & Next.js Build Artifacts
node_modules/
frontend/node_modules/
.next/
frontend/.next/
out/
frontend/out/
build/
dist/
.pnp
.pnp.js

# Environment Files & Secrets (NEVER COMMIT SECRETS)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
frontend/.env
frontend/.env.local

# Databases & Local Storage
*.db
*.sqlite
*.sqlite3
contentguard.db
backend/contentguard.db

# User Uploads (preserve the folder via .gitkeep)
uploads/*
!uploads/.gitkeep
backend/uploads/*
!backend/uploads/.gitkeep

# Operating System & IDE Files
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~
.idea/
*.sublime-project
*.sublime-workspace

# Log Files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tsbuildinfo

# Temporary Files & Archives
tmp/
temp/
*.zip
*.tar.gz
.running_pids.json
