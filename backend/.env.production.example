# =================================================================
# ContentGuard AI — Backend Production Environment Configuration
# =================================================================

PROJECT_NAME="ContentGuard AI"
VERSION="1.0.0"
ENVIRONMENT="production"
API_V1_STR="/api/v1"

# Production JWT Secret Key (Generate a secure 64-character hex string)
SECRET_KEY="replace-with-a-very-long-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Managed Database Connection (Render PostgreSQL or Neon.tech)
# Example: postgresql://username:password@ep-cool-db-12345.us-east-2.aws.neon.tech/contentguard?sslmode=require
DATABASE_URL="postgresql://user:password@hostname:5432/contentguard_db"

# Google Gemini API Key (Optional: hybrid LLM analysis; deterministic engine runs if blank)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Allowed Cross-Origin Origins (Comma-separated URLs)
CORS_ORIGINS="https://contentguard.vercel.app,https://yourdomain.com,http://localhost:3000"

# Storage
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_BYTES=15728640
