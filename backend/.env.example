# =================================================================
# ContentGuard AI — Backend Environment Configuration (.env.example)
# =================================================================
# Copy this file to .env in the backend directory:
#   Copy-Item .env.example .env
#
# IMPORTANT: Never commit your actual .env file or real secrets to Git.
# =================================================================

# Application Metadata
PROJECT_NAME="ContentGuard AI"
VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"

# Security & JWT Authentication
# In production, replace SECRET_KEY with a secure random string (e.g., openssl rand -hex 32)
SECRET_KEY="contentguard-super-secret-jwt-key-replace-in-production-2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Option A (Default for local development): Zero-config SQLite database
DATABASE_URL="sqlite:///./contentguard.db"

# Option B (Production / PostgreSQL):
# Format: postgresql://<username>:<password>@<host>:<port>/<database_name>
# Example: DATABASE_URL="postgresql://postgres:postgres@localhost:5432/contentguard_ai"

# Google Gemini AI Integration (Optional)
# If provided: Enables hybrid contextual LLM analysis alongside deterministic rules.
# If left blank: The platform automatically uses the 100% deterministic rule engine.
# Get a free API key at: https://aistudio.google.com/
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# File Upload Storage
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_BYTES=15728640

# CORS Allowed Origins
# Comma-separated list or JSON array of origins permitted to make API requests
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
